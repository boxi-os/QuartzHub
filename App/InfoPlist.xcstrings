            "value" : "QuartzHub verbindet sich mit Servern in deinem Netzwerk, etwa wenn du per SFTP, rsync oder FTP veröffentlichst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuartzHub connects to servers on your network, for example when you publish over SFTP, rsync or FTP."
