      "code": "Noto Sans Mono"
    },
    "colors": {
      "lightMode": {
        "light": "#FCFCFA",
        "lightgray": "#DDDDDD",
        "gray": "#5F5F5F",
        "darkgray": "#333333",
        "dark": "#17171A",
        "secondary": "#1463A3",
        "tertiary": "#196B6B",
        "highlight": "rgba(42, 78, 108, 0.10)",
        "textHighlight": "rgba(226, 189, 92, 0.55)"
      },
      "darkMode": {
        "light": "#16171A",
        "lightgray": "#2E2E2E",
        "gray": "#A1A1A1",
        "darkgray": "#DDDDDD",
        "dark": "#FCFCFA",
        "secondary": "#699DC3",
        "tertiary": "#2CAFAD",
        "highlight": "rgba(140, 184, 218, 0.12)",
        "textHighlight": "rgba(140, 184, 218, 0.30)"
      }
    }
