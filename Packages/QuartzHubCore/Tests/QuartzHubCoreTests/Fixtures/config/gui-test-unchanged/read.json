{
  "configuration": {
    "pageTitle": "gui-test",
    "pageTitleSuffix": "",
    "enableSPA": true,
    "enablePopovers": true,
    "analytics": null,
    "locale": "de-DE",
    "baseUrl": "quartzmac.example.net",
