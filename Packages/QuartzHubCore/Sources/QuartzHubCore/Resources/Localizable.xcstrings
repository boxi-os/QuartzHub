    "layoutEditor.frameBuilder.standardCopyHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie folgt deinen Breakpoints. Die Seitenleisten verhalten sich darin wie jeder andere Bereich: Sie kleben nicht und werden auf schmalen Breiten nicht zur Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A copy follows your breakpoints. Its sidebars behave like any other area: they do not stick, and they do not turn into a row on narrow widths."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.standardOption" : {
      "localizations" : {
        "de" : {
