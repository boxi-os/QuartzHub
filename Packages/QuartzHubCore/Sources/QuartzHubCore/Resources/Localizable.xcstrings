      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartz lädt diese Schriften erst beim Build und verweist dabei auf die veröffentlichte Website. Die Vorschau zeigt sie deshalb nicht. Speichern holt sie ins Projekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartz downloads these fonts only at build time and points at the published site for them. That is why the preview does not show them. Saving fetches them into the project."
          }
        }
      }
    },
