    "projectLayout.descriptions.styles" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles zum Aussehen der Site: Basisfarben und Schriften, Community-Themes, CSS-Variablen und eigenes CSS (in der Reihenfolge, in der sie sich gegenseitig überschreiben)."
          }
        },
        "en" : {
          "stringUnit" : {
