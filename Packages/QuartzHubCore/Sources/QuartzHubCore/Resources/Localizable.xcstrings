    "main.configMissing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz.config.yaml liegt nicht im Projektordner. Ein neu erstelltes Projekt braucht dafür einen erfolgreich durchgelaufenen Setup-Assistenten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz.config.yaml is not in the project folder. A newly created project needs the setup assistant to have run through successfully."
          }
        }
      }
    },
    "main.configNotAMapping" : {
      "comment" : "Drei Arten, wie quartz.config.yaml unlesbar ist, drei Sätze. Gesagt wird jede, statt die Datei als halb leer zu lesen und dem Nutzer eine leere Seite ohne Begründung zu zeigen; die Datei selbst ist dabei nie in Gefahr, das Speichern scheitert an ihr ebenfalls.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In quartz.config.yaml steht keine Zuordnung aus Schlüsseln und Werten. QuartzControl liest die Datei deshalb nicht; repariere sie in einem Editor oder nimm einen Wiederherstellungspunkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz.config.yaml does not hold a mapping of keys and values. QuartzControl will not read it; fix it in an editor or use a restore point."
          }
        }
      }
    },
    "main.configNotParseable" : {
      "comment" : "Der häufigste Fall: ein nicht geschlossenes Anführungszeichen, ein Tab als Einrückung. yamls eigene Meldung nennt Zeile und Spalte und bleibt deshalb englisch, wie die übrigen Werkzeugmeldungen auch.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz.config.yaml lässt sich nicht als YAML lesen: {{reason}}. Repariere sie in einem Editor oder nimm einen Wiederherstellungspunkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz.config.yaml cannot be read as YAML: {{reason}}. Fix it in an editor or use a restore point."
          }
        }
      }
    },
    "main.configPluginsNotAList" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In quartz.config.yaml ist „plugins“ keine Liste. QuartzControl liest die Datei deshalb nicht; repariere sie in einem Editor oder nimm einen Wiederherstellungspunkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In quartz.config.yaml, “plugins” is not a list. QuartzControl will not read it; fix it in an editor or use a restore point."
          }
        }
      }
    },
