      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur die Komponenten, die im Reiter „Komponenten“ hierher gezogen werden. Ohne das zeigt der Bereich alles, was die Belegung sonst noch hat."
          }
