    "publish.branchHint.codeberg" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codeberg Pages liefert den Branch „pages“ direkt aus. Nach dem ersten Push ist die Seite ohne weitere Einstellungen erreichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codeberg Pages serves the “pages” branch directly. After the first push the site is reachable with no further setup."
          }
        }
      }
    },
    "publish.branchHint.github" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiebt den Build als einzelnen Commit auf den Branch des „origin“-Remotes (dasselbe wie bei Git-Sync). In den Repository-Einstellungen muss GitHub Pages auf diesen Branch zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pushes the build as a single commit to that branch of the “origin” remote (the same one Git sync uses). GitHub Pages must be pointed at this branch in the repository settings."
          }
        }
      }
    },
    "publish.branchHint.gitlab" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung: Bei GitLab veröffentlicht der Branch allein noch nichts. Dort muss ein CI-Job die Dateien als „public“-Artefakt ausliefern. Der Push funktioniert trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: on GitLab the branch alone publishes nothing. A CI job has to ship the files as a “public” artifact. The push works regardless."
          }
        }
      }
    },
