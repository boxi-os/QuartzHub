    "main.hostKeyChanged" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host-Key von {{host}} hat sich geändert!\n\nerwartet:  {{expected}}\nempfangen: {{received}}\n\nDie Verbindung wurde abgebrochen. Das kann ein neu aufgesetzter Server sein oder ein Angriff. Prüfe den Fingerprint beim Anbieter und setze ihn erst danach über „Host-Key vergessen“ zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host key of {{host}} has changed!\n\nexpected: {{expected}}\nreceived: {{received}}\n\nThe connection was aborted. This can be a rebuilt server or an attack. Check the fingerprint with your provider and only then clear it via “Forget host key”."
          }
        }
      }
    },
