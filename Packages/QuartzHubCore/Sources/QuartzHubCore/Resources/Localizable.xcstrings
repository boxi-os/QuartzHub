          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Removed {{count}} part from the SVG code that, inlined, could run script on every page, style it or load something from elsewhere (such as <script>, onload, <style>)."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Removed {{count}} parts from the SVG code that, inlined, could run script on every page, style it or load something from elsewhere (such as <script>, onload, <style>)."
                }
              }
            }
          }
        }
      }
    },
    "snippets.svgHow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die SVG-Datei als Code einfügen?\n\nWird der SVG-Code eingefügt, ist Styling über CSS möglich. Als Bild eingebunden wird die Grafik lediglich nach quartz/static/images kopiert und verlinkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insert the SVG file as code?\n\nInserted as SVG code, the graphic can be styled with CSS. Embedded as an image, it is merely copied to quartz/static/images and linked."
          }
        }
      }
    },
