    "layoutEditor.frameBuilder.hintDragToPlace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Bereich auf eine freie Zelle, um ihn zu platzieren, oder einen platzierten zurück in diese Liste, um ihn wieder zu lösen. An den Rändern eines platzierten Bereichs stellst du ein, über wie viele Zeilen und Spalten er reicht. Ein Klick zeigt seine Einstellungen in der Seitenleiste; ein hier ausgeblendeter Bereich behält seine Spannen, ein nie platzierter hat keine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag an area onto an open cell to place it, or drag a placed one back into this list to unplace it. Drag the edges of a placed area to set how many rows and columns it spans. A click shows its settings in the side panel; an area hidden here keeps its spans, one never placed has none."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.homelessWarning" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne einfachen Bereich: {{slots}}. Was dieser Belegung gehört und in keinem eigenen Bereich liegt, erscheint auf keiner Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No plain area for: {{slots}}. Anything in that slot and in no area of its own renders on no page at all."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.lineNamesHint" : {
      "localizations" : {
