    "main.managedFileCreated" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz/styles/_quartzcontrol.scss fehlte, wird aber von custom.scss geladen. Die Datei wurde leer neu angelegt. Ladereihenfolge, Schriften und Variablen der Stile-Seite sind damit leer; ein Snapshot unter Wartung bringt den alten Stand zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz/styles/_quartzcontrol.scss was missing, although custom.scss loads it. The file has been created empty. The Styles page’s load order, fonts and variables are therefore empty; a snapshot under Maintenance brings the old state back."
          }
        }
      }
    },
    "main.managedUseRestored" : {
      "comment" : "Die Optionen eines Plugins (plugin.optionSchema): das Paket ist da, lässt sich aber nicht lesen. Bau-Tür: die verwaltete Datei der Stile-Seite und die Zeile in custom.scss, die sie lädt.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In custom.scss fehlte die Zeile @use \"./quartzcontrol\"; – sie ist wieder eingesetzt, sonst fehlten der Website Ladereihenfolge, Schriften und Variablen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "custom.scss was missing the line @use \"./quartzcontrol\"; – it has been put back, without it the site would lose its load order, fonts and variables."
          }
        }
      }
    },
