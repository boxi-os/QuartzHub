    "layoutEditor.frameBuilder.hiddenGroupsWarning" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf {{breakpoint}} ausgeblendet: {{areas}}. Die Komponenten dieser eigenen Bereiche erscheinen auf dieser Breite nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidden on {{breakpoint}}: {{areas}}. The components of these areas of their own do not appear at this width."
