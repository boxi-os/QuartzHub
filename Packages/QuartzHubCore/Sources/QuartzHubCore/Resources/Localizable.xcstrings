    "updates.core.confirm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quartz-Kern aktualisieren?\n\nDabei werden Änderungen von jackyzha0/quartz geholt und die Abhängigkeiten neu installiert; bei Konflikten kann Handarbeit nötig sein.\n\nVorher wird automatisch ein Snapshot angelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Quartz’s core?\n\nThis fetches changes from jackyzha0/quartz and reinstalls the dependencies; conflicts may require manual work.\n\nA snapshot is taken automatically first."
          }
        }
      }
    },
    "updates.core.conflictHeading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konflikte in folgenden Dateien (außer den durch .gitattributes geschützten Locale-Dateien):"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflicts in these files (aside from the locale files .gitattributes protects):"
          }
        }
      }
    },
