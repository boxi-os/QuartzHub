    "main.sshPasswordRejected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Anmeldung als {{user}}@{{host}} mit Passwort abgelehnt. Prüfe das Passwort; stimmt es, nimmt der Server Passwörter nicht in der Form an, in der QuartzControl sie schickt, und es bleibt die Anmeldung mit Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused the login as {{user}}@{{host}} with a password. Check the password; if it is right, the server does not take passwords the way QuartzControl sends them, and logging in with a key remains."
          }
        }
      }
    },
    "main.sshPortRefused" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{host}} hat die Verbindung auf Port {{port}} abgelehnt. Prüfe den Port im Zugang und ob dort ein SSH-Server läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{host}} refused the connection on port {{port}}. Check the port in the login and whether an SSH server runs there."
          }
