    "settings.maintenance.unreadableHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Start konnte QuartzControl eine seiner Dateien nicht lesen, vermutlich, weil das Programm beim Speichern hart beendet wurde. Die Datei wurde zur Seite gelegt statt überschrieben; was darin stand (etwa Zugänge oder die Projektliste), fehlt in QuartzControl und muss neu angelegt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At startup, QuartzControl could not read one of its own files, most likely because the program was killed while saving it. The file was moved aside instead of overwritten; whatever it held (connections, say, or the project list) is missing from QuartzControl and has to be set up again."
          }
        }
      }
    },
    "settings.maintenance.unreadableTitle" : {
