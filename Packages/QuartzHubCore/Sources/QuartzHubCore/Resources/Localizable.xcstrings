    "themeEditor.unusedFonts.confirmNoFiles" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{family}}“ entfernen?\n\nDie @font-face-Regeln verschwinden aus dem CSS. Gelöscht wird keine Datei, weil andere Regeln sie noch nennen oder sie nicht im Projekt liegt. Zurück geht es nur über einen Snapshot oder git."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove “{{family}}”?\n\nIts @font-face rules leave the CSS. No file is deleted, because other rules still name it or it is not in the project. The only way back is a snapshot or git."
          }
        }
      }
    },
    "themeEditor.unusedFonts.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "custom.scss deklariert diese Schriften, aber weder eine Schriftart-Einstellung noch eine Variable noch ein Stylesheet unter quartz/styles, quartz/components/styles oder quartz/static nennt sie. Die Schriftdateien werden trotzdem mit jedem Build veröffentlicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "custom.scss declares these fonts, but no font setting, no variable and no stylesheet under quartz/styles, quartz/components/styles or quartz/static names them. The font files are still published with every build."
          }
        }
      }
    },
