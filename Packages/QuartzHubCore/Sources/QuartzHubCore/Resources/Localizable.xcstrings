    "layoutEditor.frameBuilder.whatIsAFrame" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Frame ist das Raster einer Seite: welche Bereiche es gibt (Kopfbereich, Seitenleisten, Inhalt, Fußzeile), wo sie liegen und wie breit sie sind. Was in den Bereichen erscheint, legst du im Reiter „Komponenten“ fest, und dort wählst du auch den Frame je Seitentyp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frame is a page’s grid: which areas exist (header, sidebars, content, footer), where they sit and how wide they are. What appears in those areas is set on the “Components” tab, and that is also where you pick the frame for each page type."
          }
        }
      }
    },
