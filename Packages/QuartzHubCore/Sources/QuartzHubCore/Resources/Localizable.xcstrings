    "layoutEditor.frameBuilder.showRefused" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} bleibt ausgeblendet, weil auf seinen Zellen ein anderer Bereich liegt. Ziehe es auf eine freie Zelle, um es zu zeigen; gibt es keine, gib dem Raster erst eine Zeile mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} stays hidden, because another area lies on its cells. Drag it onto a free cell to show it; if there is none, give the grid another row first."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.showRefusedOutside" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} bleibt ausgeblendet, weil seine Zellen nicht mehr im Raster liegen. Ziehe es auf eine freie Zelle, um es zu zeigen; gibt es keine, gib dem Raster erst eine Zeile mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{name}} stays hidden, because its cells are no longer in the grid. Drag it onto a free cell to show it; if there is none, give the grid another row first."
          }
        }
      }
    },
