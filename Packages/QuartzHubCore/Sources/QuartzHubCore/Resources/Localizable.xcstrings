    "backups.movedFoldersHeading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiseitegelegte Content-Ordner"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set-aside content folders"
          }
        }
      }
    },
    "backups.movedFoldersHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel des Content-Ordners wird der bisherige hierher verschoben statt gelöscht. Das ist kein Backup deiner Notizen: ein verknüpfter Vault wird nie kopiert, nur die Verknüpfung selbst notiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the content source is switched, the previous folder is moved here rather than deleted. This is not a backup of your notes: a linked vault is never copied, only the link itself recorded."
          }
        }
      }
    },
    "backups.newHeading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuer Snapshot"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New snapshot"
          }
        }
      }
    },
    "backups.newHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Snapshot sichert: Konfiguration, Plugin-Sperrdatei, Layout-Frames, eigene Stylesheets, Übersetzungen und Veröffentlichungsziele. Nicht enthalten sind node_modules, der Build-Ordner und installierte Plugin-Dateien. Diese entstehen beim nächsten Build ohnehin neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A snapshot captures: the configuration, the plugin lockfile, layout frames, your own stylesheets, translations and publish targets. Not included are node_modules, the build folder and installed plugin files. The next build produces those anyway."
          }
        }
      }
    },
    "backups.noDiff" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Textunterschied (z. B. eine Binärdatei)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No text difference (a binary file, for instance)."
          }
        }
      }
    },
    "backups.none" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Snapshots. Vor jedem Kern-Update, jeder Plugin-Änderung, jedem Content-Wechsel und jedem Vorlagen-Import wird automatisch einer angelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No snapshots yet. One is taken automatically before every core update, plugin change, content switch and template import."
          }
        }
      }
    },
    "backups.panelEmptyText" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle links einen Snapshot: Hier steht dann, welche Dateien sich seitdem geändert haben, und du kannst alles oder einzelne Dateien wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a snapshot on the left: this panel then lists the files that have changed since, and you can restore all of them or a few."
          }
        }
      }
    },
    "backups.panelEmptyTitle" : {
      "localizations" : {
        "de" : {
