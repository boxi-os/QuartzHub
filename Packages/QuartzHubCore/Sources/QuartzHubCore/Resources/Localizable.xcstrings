    "extraContent.intro" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Box ist ein eigener Eintrag von quartz-layout-box. Ihr Inhalt steht entweder als Text in der Konfiguration oder in einer Datei unter quartz/static. Wo sie steht, legst du auf der Layout-Bühne fest. Jede Änderung wird sofort gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each box is an entry of quartz-layout-box of its own. Its content is either text in the configuration or a file under quartz/static. Where it sits is set on the layout stage. Every change is saved at once."
          }
        }
      }
    },
