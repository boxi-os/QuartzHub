    "main.relayCheckCertificate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat des Servers wird nicht anerkannt ({{code}}). Browser lehnen dort auch das Formular ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's certificate is not accepted ({{code}}). Browsers refuse the form there as well."
          }
        }
      }
    },
    "main.relayCheckDropped" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Verbindung ohne Antwort beendet ({{code}})."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server closed the connection without an answer ({{code}})."
          }
        }
      }
    },
    "main.relayCheckIncomplete" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat geantwortet (HTTP {{status}}), aber nach {{seconds}} Sekunden war die Antwort noch nicht vollständig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server answered (HTTP {{status}}), but the answer was not complete after {{seconds}} seconds."
          }
        }
      }
    },
    "main.relayCheckNoName" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name des Servers konnte nicht aufgelöst werden ({{code}}). Stimmt die Adresse von send.php?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's name could not be resolved ({{code}}). Is the send.php address right?"
          }
        }
      }
    },
    "main.relayCheckNoRoute" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server ist von diesem Rechner aus nicht erreichbar ({{code}}). Stimmt die Adresse, oder liegt eine Firewall dazwischen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server cannot be reached from this machine ({{code}}). Is the address right, or is a firewall in between?"
          }
        }
      }
    },
    "main.relayCheckNoTls" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Server kam keine verschlüsselte Verbindung zustande ({{code}}). Spricht er unter dieser Adresse HTTPS?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encrypted connection to the server came about ({{code}}). Does it speak HTTPS at this address?"
          }
        }
      }
    },
    "main.relayCheckRefused" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server nimmt an diesem Port keine Verbindung an ({{code}}). Stimmen Adresse und Port?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server accepts no connection on this port ({{code}}). Are address and port right?"
          }
        }
      }
    },
    "main.relayCheckTimeout" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach {{seconds}} Sekunden kam keine Antwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No answer came within {{seconds}} seconds."
          }
        }
      }
    },
    "main.relayDirSymlink" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „{{path}}“ auf dem Weg zum Relay ist auf dem Server ein symbolischer Link, durch den QuartzControl nicht hochlädt. Lösche den Link auf dem Server oder wähle im Abschnitt „Relay“ einen anderen Unterordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder “{{path}}” on the way to the relay is a symbolic link on the server, which QuartzControl does not upload through. Delete the link on the server or choose another folder in the Relay section."
          }
        }
      }
    },
    "main.relayDirUnchecked" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob der Ordner „{{path}}“ auf dem Weg zum Relay auf dem Server ein symbolischer Link ist, konnte nicht geprüft werden ({{reason}}). QuartzControl lädt das Relay erst hoch, wenn sich das prüfen lässt: Prüfe die Rechte dieses Ordners und der Ordner darüber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether the folder “{{path}}” on the way to the relay is a symbolic link on the server could not be checked ({{reason}}). QuartzControl uploads the relay only once it can check this: check the permissions of this folder and the folders above it."
          }
        }
      }
    },
    "main.relayDirUnlisted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "der Server zeigt ihn nicht in der Liste des Ordners darüber"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the server does not show it in the listing of the folder above"
          }
        }
      }
    },
    "main.relayDirWriteOnly" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob der Ordner „{{path}}“ auf dem Weg zum Relay auf dem Server ein symbolischer Link ist, konnte nicht geprüft werden ({{reason}}). Der Server lässt diesen Zugang nur schreiben, nicht lesen; für das Relay braucht QuartzControl einen Zugang, der auch lesen darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether the folder “{{path}}” on the way to the relay is a symbolic link on the server could not be checked ({{reason}}). The server lets this login write but not read; for the relay QuartzControl needs a login that may read as well."
          }
        }
      }
    },
    "main.relayExportPlaceholders" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.php enthält Platzhalter: Ohne gespeicherte Angaben trage Absender, Origins und Adressen dort selbst ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.php holds placeholders: without stored values, fill in sender, origins and addresses there yourself."
          }
        }
      }
    },
    "main.relayMissingRecipients" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht hochgeladen: Für {{names}} fehlt eine Adresse. Das Relay würde diese Formulare abweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not uploaded: {{names}} has no address. The relay would refuse these forms."
          }
        }
      }
    },
    "main.relayNoTarget" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für das Relay ist noch kein Ziel gewählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No target is chosen for the relay yet."
          }
        }
      }
    },
    "main.relayRemoveFolderMissing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Ordner „{{dest}}“ und den darüber gibt es nicht. Ist das Laufwerk verbunden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neither the folder “{{dest}}” nor the one above it exists. Is the drive connected?"
          }
        }
      }
    },
    "main.relayRemoveForeign" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „{{path}}“ liegt seit dem Hochladen ein anderes Relay, etwa das eines anderen Projekts. QuartzControl löscht es nicht; soll es weg, lösche send.php, config.php und config.generated.php dort selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under “{{path}}” there is another relay since the upload, another project’s perhaps. QuartzControl does not delete it; if it is to go, delete send.php, config.php and config.generated.php there yourself."
          }
        }
      }
    },
    "main.relayRemoveGone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „{{path}}“ lag kein Relay mehr.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There was no relay under “{{path}}” any more.\n"
          }
        }
      }
    },
    "main.relayRemoveLoginGone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugang des Ziels „{{target}}“ ist gelöscht. Das Relay liegt noch auf {{then}} unter „{{path}}“: Lösche send.php, config.php und config.generated.php dort selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The login of the target “{{target}}” has been deleted. The relay is still on {{then}} under “{{path}}”: delete send.php, config.php and config.generated.php there yourself."
          }
        }
      }
    },
    "main.relayRemoveMoved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel „{{target}}“ zeigt seit dem Hochladen an einen anderen Ort. Das Relay liegt noch unter „{{path}}“{{login}}: Lösche send.php, config.php und config.generated.php dort selbst, oder stelle das Ziel zurück und entferne es dann hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The target “{{target}}” points to another place since the upload. The relay is still under “{{path}}”{{login}}: delete send.php, config.php and config.generated.php there yourself, or set the target back and remove it here then."
          }
        }
      }
    },
    "main.relayRemoveMovedLogin" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Zugang „{{name}}“)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (login “{{name}}”)"
          }
        }
      }
    },
    "main.relayRemoveNoGeneration" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob unter „{{path}}“ noch das von hier hochgeladene Relay liegt, konnte nicht geprüft werden: config.generated.php trägt keine Kennung, die QuartzControl lesen kann. QuartzControl löscht dort nichts, ohne es zu wissen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether the relay uploaded from here is still under “{{path}}” could not be checked: config.generated.php carries no mark QuartzControl can read. QuartzControl deletes nothing there without knowing."
          }
        }
      }
    },
    "main.relayRemoveNotUploaded" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay wurde von hier aus noch nicht hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay has not been uploaded from here yet."
          }
        }
      }
    },
    "main.relayRemoveRefused" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{path}} konnte auf dem Server nicht gelöscht werden ({{reason}}).\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{path}} could not be deleted on the server ({{reason}}).\n"
          }
        }
      }
    },
    "main.relayRemoveRefusedRest" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay ist damit nicht vom Server entfernt. Lösche diese Dateien dort selbst, oder erlaube dem Zugang das Löschen in diesem Ordner und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So the relay is not removed from the server. Delete these files there yourself, or allow the login to delete in this folder and try again."
          }
        }
      }
    },
    "main.relayRemoveServer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugang „{{login}}“ zeigt seit dem Hochladen auf {{now}} statt auf {{then}}. Das Relay liegt noch auf {{then}} unter „{{path}}“: Lösche send.php, config.php und config.generated.php dort selbst, oder stelle den Zugang zurück und entferne es dann hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The login “{{login}}” points to {{now}} instead of {{then}} since the upload. The relay is still on {{then}} under “{{path}}”: delete send.php, config.php and config.generated.php there yourself, or set the login back and remove it here then."
          }
        }
      }
    },
    "main.relayRemoveUnchecked" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob {{path}} auf dem Server noch liegt, konnte nicht geprüft werden: Der Zugang darf den Ordner „{{folder}}“ nicht öffnen ({{reason}}).\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether {{path}} is still on the server could not be checked: the login may not open the folder “{{folder}}” ({{reason}}).\n"
          }
        }
      }
    },
    "main.relayRemoveUncheckedMany" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob {{paths}} auf dem Server noch liegen, konnte nicht geprüft werden: Der Zugang darf den Ordner „{{folder}}“ nicht öffnen ({{reason}}).\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether {{paths}} are still on the server could not be checked: the login may not open the folder “{{folder}}” ({{reason}}).\n"
          }
        }
      }
    },
    "main.relayRemoveUnverified" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob unter „{{path}}“ noch das von hier hochgeladene Relay liegt, konnte nicht geprüft werden: config.generated.php ist nicht lesbar ({{reason}}). QuartzControl löscht dort nichts, ohne es zu wissen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether the relay uploaded from here is still under “{{path}}” could not be checked: config.generated.php cannot be read ({{reason}}). QuartzControl deletes nothing there without knowing."
          }
        }
      }
    },
    "main.relayRemovedRest" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „{{subdir}}/counters“ bleibt mit den Zählern des Servers liegen; ohne send.php nimmt dort nichts mehr Formulare an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder “{{subdir}}/counters” stays with the server’s counts; without send.php nothing there takes forms any more."
          }
        }
      }
    },
    "main.relayRemovedRestCounterDir" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegen bleiben der Ordner „{{subdir}}/counters“ und die Zähler des Servers unter „{{counterDir}}“; ohne send.php nimmt dort nichts mehr Formulare an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder “{{subdir}}/counters” and the server’s counts under “{{counterDir}}” stay; without send.php nothing there takes forms any more."
          }
        }
      }
    },
    "main.relayRsyncConflict" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht hochgeladen: Das Ziel „{{target}}“ überträgt per rsync und löscht dabei, was der Build nicht hat, also auch „{{path}}“. Trage „{{path}}“ dort in die Ausschlüsse ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not uploaded: the target “{{target}}” transfers with rsync and deletes what the build lacks, “{{path}}” included. Add “{{path}}” to its excludes."
          }
        }
      }
    },
    "main.relaySubdirInvalid" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Unterordner „{{subdir}}“ ist kein eigener Ordner unter dem Pfad des Ziels. Trage im Abschnitt „Relay“ einen ein, z. B. „forms“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The folder “{{subdir}}” is not one of its own below the target’s path. Enter one in the Relay section, such as “forms”."
          }
        }
      }
    },
    "main.relaySubdirRsyncChar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Unterordner „{{subdir}}“ kann rsync wegen „{{char}}“ nicht sicher übertragen. Wähle im Abschnitt „Relay“ einen Unterordner ohne dieses Zeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync cannot transfer the folder “{{subdir}}” safely because of “{{char}}”. Choose a folder without it in the Relay section."
          }
        }
      }
    },
    "main.relaySubdirRsyncSpace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Unterordner „{{subdir}}“ kann rsync wegen des Leerzeichens nicht sicher übertragen. Wähle im Abschnitt „Relay“ einen Unterordner ohne Leerzeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync cannot transfer the folder “{{subdir}}” safely because of the space. Choose a folder without spaces in the Relay section."
          }
        }
      }
    },
    "main.relayTargetType" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay lässt sich nur über ein SFTP-, FTP- oder Ordner-Ziel hochladen, nicht über „{{type}}“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay can only be uploaded through an SFTP, FTP or folder target, not through “{{type}}”."
          }
        }
      }
    },
    "main.rsyncExitCode" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync endete mit Code {{code}}, ohne eine Meldung auszugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync exited with code {{code}} without printing a message."
          }
        }
      }
    },
    "main.rsyncHostKeyMismatch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host-Key von {{host}} stimmt nicht mit dem gespeicherten überein.\n\nerwartet:  {{expected}}\nempfangen: {{received}}\n\nDie Übertragung wurde abgebrochen. Das kann ein neu aufgesetzter Server sein oder ein Angriff. Prüfe den Fingerprint beim Anbieter und setze ihn erst danach über „Host-Key vergessen“ zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host key of {{host}} does not match the stored one.\n\nexpected: {{expected}}\nreceived: {{received}}\n\nThe transfer was aborted. This can be a rebuilt server or an attack. Check the fingerprint with your provider and only then clear it via “Forget host key”."
          }
        }
      }
    },
    "main.rsyncKeyNotAFile" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für rsync muss der private Schlüssel als Datei hinterlegt sein; ein eingefügter Schlüsseltext reicht nicht, weil ssh eine Datei braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync needs the private key as a file; a pasted key text is not enough, because ssh wants a file."
          }
        }
      }
    },
    "main.rsyncKeyRejected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Anmeldung als {{user}}@{{host}} abgelehnt. Angeboten wurde: {{identity}}. Prüfe, ob genau dieser Schlüssel beim Anbieter hinterlegt ist und ob der Pfad auf den privaten Schlüssel zeigt, nicht auf die .pub-Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused the login as {{user}}@{{host}}. What was offered: {{identity}}. Check that this exact key is registered with the provider and that the path points at the private key, not the .pub file."
          }
        }
      }
    },
    "main.rsyncNoPinnedHostKey" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host-Key dieses Servers ist noch nicht vollständig hinterlegt. Bitte das Ziel einmal über SFTP veröffentlichen (dabei wird der Schlüssel bestätigt und gespeichert) und danach auf rsync umstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host key of this server is not fully stored yet. Publish to this target over SFTP once (that confirms and stores the key) and then switch to rsync."
          }
        }
      }
    },
    "main.rsyncNotInstalled" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Rechner ist kein rsync installiert. Unter Debian und Ubuntu: sudo apt install rsync. Bis dahin überträgt SFTP dieselben Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rsync is installed on this machine. On Debian and Ubuntu: sudo apt install rsync. Until then SFTP transfers the same files."
          }
        }
      }
    },
    "main.rsyncPasswordAuth" : {
      "comment" : "Publishing - rsync",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync kann kein Passwort übergeben. Bitte einen Zugang mit Schlüsseldatei oder SSH-Agent verwenden oder bei SFTP bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync cannot hand over a password. Please use a credential with a key file or the SSH agent, or stay on SFTP."
          }
        }
      }
    },
    "main.rsyncPathWithSpace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Remote-Pfad mit Leerzeichen lässt sich mit rsync nicht sicher übertragen. Bitte SFTP für dieses Ziel verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A remote path containing a space cannot be transferred safely with rsync. Please use SFTP for this target."
          }
        }
      }
    },
    "main.rsyncPathWithSpecial" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Remote-Pfad mit dem Zeichen „{{char}}“ lässt sich mit rsync nicht sicher übertragen. Bitte SFTP für dieses Ziel verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A remote path containing the character “{{char}}” cannot be transferred safely with rsync. Please use SFTP for this target."
          }
        }
      }
    },
    "main.rsyncUnsupportedPlatform" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync gibt es auf diesem Betriebssystem nicht. Bitte SFTP verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rsync does not exist on this operating system. Please use SFTP."
          }
        }
      }
    },
    "main.secretStorageUnavailable" : {
      "comment" : "Credentials Sagt den Grund *und* den Weg: Ohne den zweiten Satz weiß der Nutzer, dass es nicht geht, aber nicht, was er dagegen tun kann - und tun kann er etwas, das ist der ganze Grund, warum diese Antwort von „verschlüsselt\" getrennt gemeldet wird.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zugangsdaten können nicht sicher gespeichert werden, weil der Schlüsselbund des Systems nicht verfügbar ist. Unter Linux hilft ein laufender Schlüsselbund, etwa gnome-keyring oder KWallet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credentials cannot be stored securely because the system keyring is unavailable. On Linux, running a keyring such as gnome-keyring or KWallet fixes this."
          }
        }
      }
    },
    "main.secretStorageUnavailableMac" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zugangsdaten können nicht gespeichert werden: macOS hat dieser Fassung von QuartzControl den Zugriff auf den Schlüsselbund verweigert. Beende QuartzControl, starte es neu und wähle im Dialog „Immer erlauben“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credentials cannot be stored: macOS denied this version of QuartzControl access to the Keychain. Quit QuartzControl, start it again and choose “Always Allow” in the dialog."
          }
        }
      }
    },
    "main.secretStorageUnreadable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherten Zugangsdaten lassen sich nicht lesen, weil der Schlüsselbund des Systems nicht verfügbar ist. Unter Linux hilft ein laufender Schlüsselbund, etwa gnome-keyring oder KWallet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stored credentials cannot be read because the system keyring is unavailable. On Linux, running a keyring such as gnome-keyring or KWallet fixes this."
          }
        }
      }
    },
    "main.secretStorageUnreadableMac" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherten Zugangsdaten können nicht gelesen werden: macOS hat dieser Fassung von QuartzControl den Zugriff auf den Schlüsselbund verweigert. Beende QuartzControl, starte es neu und wähle im Dialog „Immer erlauben“. Die Zugangsdaten sind dann wieder da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stored credentials cannot be read: macOS denied this version of QuartzControl access to the Keychain. Quit QuartzControl, start it again and choose “Always Allow” in the dialog. The credentials will then be back."
          }
        }
      }
    },
    "main.secretUndecryptable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherten Zugangsdaten lassen sich mit dem Schlüssel dieses Rechners nicht entschlüsseln, etwa weil sie von einem anderen Rechner stammen. Gib sie unter Einstellungen → Zugänge neu ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The stored credentials cannot be decrypted with this computer’s key, for example because they come from another computer. Enter them again under Settings → Connections."
          }
        }
      }
    },
    "main.serverAlreadyRunningOutside" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Projekt läuft schon ein Server, der nicht aus QuartzControl gestartet wurde (Port {{port}}, Prozess {{pid}}). Ein zweiter würde in denselben Ausgabeordner bauen. Die Karte „Laufende Server auf diesem Rechner“ zeigt ihn und kann ihn beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A server for this project is already running that was not started from QuartzControl (port {{port}}, process {{pid}}). A second one would build into the same output folder. The card “Servers running on this machine” shows it and can stop it."
          }
        }
      }
    },
    "main.serverLogUnavailable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausgabe des Servers konnte nicht mitgeschrieben werden ({{reason}}). Der Server läuft, diese Konsole bleibt für diesen Lauf leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server’s output could not be recorded ({{reason}}). The server is running; this console stays empty for this run."
          }
        }
      }
    },
    "main.serverPortTaken" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port {{from}} ist belegt, der Server nimmt {{to}}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port {{from}} is in use, the server takes {{to}} instead."
          }
        }
      }
    },
    "main.serverPortTakenBehindTunnel" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belegte Ports: {{ports}}. Mit Remote-Dev-Host ({{host}}) weicht der Server nicht auf andere aus, weil der Tunnel genau diese Ports weiterreicht. Gib sie frei oder stell in den Server-Einstellungen andere ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ports in use: {{ports}}. With a remote dev host ({{host}}) the server does not move to others, because the tunnel forwards exactly these ports. Free them or set others in the server settings."
          }
        }
      }
    },
    "main.serverWaitsForBuild" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft ein Build nach „{{dir}}“. Der Server startet, sobald er fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A build into “{{dir}}” is running. The server starts as soon as it has finished."
          }
        }
      }
    },
    "main.serverWaitsForWsPort" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port {{port}} antwortet, der WebSocket-Port {{wsPort}} noch nicht. QuartzControl wartet auf ihn oder auf die Zeile „Started a Quartz server“, bevor der Server als gestartet gilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port {{port}} answers, the websocket port {{wsPort}} does not yet. QuartzControl waits for it or for the line “Started a Quartz server” before the server counts as started."
          }
        }
      }
    },
    "main.serverWsPortIsHttpPort" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port {{from}} nimmt jetzt der Server selbst für die Seite; die automatische Aktualisierung nimmt {{to}}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port {{from}} is now the server’s own page port; live reload takes {{to}} instead."
          }
        }
      }
    },
    "main.sftpModesProgress" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechte von {{path}}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "permissions of {{path}}"
          }
        }
      }
    },
    "main.sftpModesRefused" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server lehnt chmod ab: {{count}} von {{total}} früher hochgeladenen Dateien bleiben für jeden Account des Servers beschreibbar.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refuses chmod: {{count}} of {{total}} files uploaded earlier stay writable by every account on the server.\n"
          }
        }
      }
    },
    "main.sftpModesSettled" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmalig {{count}} von {{total}} früher hochgeladenen Dateien auf 0644 gesetzt: Bis 1.1.0 lud QuartzControl sie für jeden Account des Servers beschreibbar hoch.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set {{count}} of {{total}} files uploaded earlier to 0644, once: up to 1.1.0 QuartzControl uploaded them writable by every account on the server.\n"
          }
        }
      }
    },
    "main.sftpModesUnfinished" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{count}} von {{total}} früher hochgeladenen Dateien auf 0644 gesetzt, dann brach die Verbindung ab. Die übrigen {{left}} prüft erst der nächste Upload, bis dahin können sie für jeden Account des Servers beschreibbar bleiben.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set {{count}} of {{total}} files uploaded earlier to 0644, then the connection broke. The next upload checks the other {{left}}; until then they may stay writable by every account on the server.\n"
          }
        }
      }
    },
    "main.snapshotMissing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Snapshot „{{id}}“ gibt es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no snapshot “{{id}}”."
          }
        }
      }
    },
    "main.snapshotStageFailed" : {
      "comment" : "Snapshots",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Projektstand konnte nicht erfasst werden:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The project state could not be captured:"
          }
        }
      }
    },
    "main.snapshotVaultUntouched" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: content/ zeigt auf einen Ordner außerhalb des Projekts (z. B. einen Obsidian-Vault). Dessen Dateien wurden nicht angetastet; alles außerhalb von content/ wurde wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: content/ points at a folder outside the project (e.g. an Obsidian vault). Its files were left untouched; everything outside content/ was restored."
          }
        }
      }
    },
    "main.snapshotWriteTreeFailed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Snapshot konnte nicht angelegt werden: git write-tree lieferte kein Ergebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The snapshot could not be taken: git write-tree returned nothing."
          }
        }
      }
    },
    "main.snippetDirLink" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Weg nach „{{dir}}“ führt über eine Verknüpfung. Lesen geht, schreiben tut QuartzControl dort nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way to “{{dir}}” leads through a link. Reading works; QuartzControl does not write there."
          }
        }
      }
    },
    "main.snippetDirOutside" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{dir}}“ führt aus dem Projektordner hinaus. QuartzControl liest und schreibt dort nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{{dir}}” leads out of the project folder. QuartzControl does not read or write there."
          }
        }
      }
    },
    "main.snippetDirReserved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{dir}}“ liegt in einem Ordner, der einem Werkzeug gehört (.git, node_modules, .quartz, .quartz-gui oder der Ausgabeordner). Wähle einen Ordner unter quartz/static."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{{dir}}” is inside a folder that belongs to a tool (.git, node_modules, .quartz, .quartz-gui or the output folder). Choose a folder under quartz/static."
          }
        }
      }
    },
    "main.snippetExtensionInvalid" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{name}}“ hat eine Endung, die hier nicht passt. Erlaubt: {{allowed}}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{{name}}” has an extension that does not fit here. Allowed: {{allowed}}."
          }
        }
      }
    },
    "main.snippetNameInvalid" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{name}}“ ist kein brauchbarer Dateiname. Erlaubt ist ein Name ohne Schrägstrich, der nicht mit einem Punkt beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{{name}}” is not a usable file name. Use a name without a slash that does not start with a dot."
          }
        }
      }
    },
    "main.snippetTooLarge" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{name}}“ ist größer als {{limit}} MB."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{{name}}” is larger than {{limit}} MB."
          }
        }
      }
    },
    "main.sshAgentRejected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Anmeldung als {{user}}@{{host}} mit den Schlüsseln aus dem SSH-Agent abgelehnt. Prüfe, ob einer davon beim Anbieter hinterlegt ist; welche der Agent hält, zeigt „ssh-add -l“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused the login as {{user}}@{{host}} with the keys in the SSH agent. Check that one of them is registered with the provider; “ssh-add -l” lists the ones the agent holds."
          }
        }
      }
    },
