    "layoutEditor.frameBuilder.standardShapeDiffers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spaltenzahl in variables.scss weicht hier von Quartz’ Anordnung ab ({{breakpoints}}); Vorschau und Kopie zeigen dort Quartz’ Spalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number of columns in variables.scss differs from Quartz’s arrangement here ({{breakpoints}}); preview and copy show Quartz’s columns there."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.standardSource" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Maße stammen aus quartz/styles/variables.scss und base.scss dieses Projekts: Spalten {{columns}}, Abstände {{gap}}, Seite höchstens {{max}}, Umschalten bei {{desktop}} / {{mobile}} px."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sizes come from this project’s quartz/styles/variables.scss and base.scss: columns {{columns}}, gaps {{gap}}, a page of at most {{max}}, switching at {{desktop}} / {{mobile}} px."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.standardSourceUnavailable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Maße dieses Projekts konnten nicht gelesen werden: {{reason}} Gezeigt sind Quartz’ eigene: Spalten {{columns}}, Abstände {{gap}}, Seite höchstens {{max}}, Umschalten bei {{desktop}} / {{mobile}} px."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This project’s sizes could not be read: {{reason}} Shown are Quartz’s own: columns {{columns}}, gaps {{gap}}, a page of at most {{max}}, switching at {{desktop}} / {{mobile}} px."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.standardText" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So teilt Quartz eine Seite auf, solange kein eigener Frame gewählt ist: Seitenleisten links und rechts, dazwischen Kopfbereich, Inhalt und Fußzeile. Umgeschaltet wird, wo quartz/styles/variables.scss es sagt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is how Quartz divides a page while no frame of your own is chosen: sidebars left and right, with the header, content and footer between them. It switches where quartz/styles/variables.scss says."
          }
        }
      }
    },
    "layoutEditor.frameBuilder.standardTitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
