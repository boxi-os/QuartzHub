    "home.confirmRemoveRelay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{name}}“ aus der Liste entfernen?\n\nDer Ordner auf der Festplatte bleibt unangetastet. Die Empfänger-Adressen und Captcha-Secrets des Formular-Relays löscht QuartzControl dabei; wer das Projekt wieder hinzufügt, trägt sie neu ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove “{{name}}” from the list?\n\nThe folder on disk is left untouched. QuartzControl deletes the form relay’s recipient addresses and captcha secrets; adding the project again means entering them again."
          }
        }
      }
    },
    "home.confirmRemoveRunning" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{name}}“ aus der Liste entfernen?\n\nDer laufende Dev-Server wird dabei beendet. Der Ordner auf der Festplatte bleibt unangetastet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove “{{name}}” from the list?\n\nIts running dev server will be stopped. The folder on disk is left untouched."
          }
        }
      }
    },
    "home.confirmRemoveRunningRelay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{name}}“ aus der Liste entfernen?\n\nDer laufende Dev-Server wird dabei beendet. Der Ordner auf der Festplatte bleibt unangetastet. Die Empfänger-Adressen und Captcha-Secrets des Formular-Relays löscht QuartzControl dabei; wer das Projekt wieder hinzufügt, trägt sie neu ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove “{{name}}” from the list?\n\nIts running dev server will be stopped. The folder on disk is left untouched. QuartzControl deletes the form relay’s recipient addresses and captcha secrets; adding the project again means entering them again."
          }
        }
      }
    },
