          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHP at {{url}} lacks the mbstring extension, without which the relay accepts no message. Ask the host to enable it."
          }
        }
      }
    },
    "formsEditor.relay.checkRelayOrigin" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay unter {{url}} nimmt keine Anfragen von der Adresse der Website an. Trage sie unter „Erlaubte Origins“ ein und lade das Relay erneut hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay at {{url}} does not accept requests from the site’s address. Add it under “Allowed origins” and upload the relay again."
          }
        }
      }
    },
    "formsEditor.relay.checkRelayOriginAny" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay unter {{url}} nimmt keine Anfragen von {{origin}} an, obwohl „Erlaubte Origins“ leer ist und jede erlaubt: Dort antwortet ein anderes Relay als das eben hochgeladene. Prüfe die Adresse von send.php und den Unterordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay at {{url}} does not accept requests from {{origin}}, although “Allowed origins” is empty and allows any: another relay than the one just uploaded answers there. Check the address of send.php and the subfolder."
          }
        }
      }
    },
    "formsEditor.relay.checkRelayOriginBase" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay unter {{url}} nimmt keine Anfragen von {{origin}} an, der Adresse aus der Basis-URL des Projekts. Korrigiere die Basis-URL unter „Konfiguration“ oder trage {{origin}} unter „Erlaubte Origins“ ein und lade das Relay danach erneut hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay at {{url}} does not accept requests from {{origin}}, the address from the project’s base URL. Correct the base URL under “Configuration” or add {{origin}} under “Allowed origins”, then upload the relay again."
          }
        }
      }
    },
    "formsEditor.relay.checkRelayOriginOther" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay unter {{url}} nimmt keine Anfragen von {{origin}} an, obwohl sie unter „Erlaubte Origins“ steht: Dort antwortet ein anderes Relay als das eben hochgeladene. Prüfe die Adresse von send.php und den Unterordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay at {{url}} does not accept requests from {{origin}}, although it is listed under “Allowed origins”: another relay than the one just uploaded answers there. Check the address of send.php and the subfolder."
          }
        }
      }
    },
    "formsEditor.relay.checkRelaySecret" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay unter {{url}} findet in seiner config.php kein brauchbares Secret, die eben hochgeladene hat eines. Stimmen Ziel und Unterordner zur Adresse von send.php?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay at {{url}} finds no usable secret in its config.php, while the one just uploaded has one. Do the target and the folder match the send.php address?"
          }
        }
      }
    },
    "formsEditor.relay.checkUnreachable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
