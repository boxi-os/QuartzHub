    "themeEditor.unusedFonts.confirm" : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "„{{family}}“ entfernen?\n\nDie @font-face-Regeln verschwinden aus dem CSS und eine Datei wird aus quartz/static/fonts gelöscht. Zurück geht es nur über einen Snapshot oder git."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "„{{family}}“ entfernen?\n\nDie @font-face-Regeln verschwinden aus dem CSS und {{count}} Dateien werden aus quartz/static/fonts gelöscht. Zurück geht es nur über einen Snapshot oder git."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Remove “{{family}}”?\n\nIts @font-face rules leave the CSS and one file is deleted from quartz/static/fonts. The only way back is a snapshot or git."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Remove “{{family}}”?\n\nIts @font-face rules leave the CSS and {{count}} files are deleted from quartz/static/fonts. The only way back is a snapshot or git."
                }
              }
            }
          }
        }
      }
    },
    "themeEditor.unusedFonts.confirmButton" : {
