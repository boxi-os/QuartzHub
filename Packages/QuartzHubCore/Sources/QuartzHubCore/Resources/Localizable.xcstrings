      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Content-Ordner ist mit einem Vault außerhalb des Projekts verknüpft. Dieser lässt sich nicht mitsichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your content folder is linked to a vault outside the project. It cannot be included."
