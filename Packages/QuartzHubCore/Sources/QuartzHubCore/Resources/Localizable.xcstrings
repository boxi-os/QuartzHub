    "main.buildDirServerRunning" : {
      "comment" : "Der Dev-Server baut bei jeder Änderung neu, ein Build leert seinen Ordner zuerst - beide zugleich in denselben Ordner hinterlässt einen Stand, der von keinem der beiden ist.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
