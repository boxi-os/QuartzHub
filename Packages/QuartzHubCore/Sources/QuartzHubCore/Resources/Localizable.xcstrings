    "backups.resetProjectHead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch den Projekt-Commit auf {{commit}} zurücksetzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also reset the project commit to {{commit}}"
          }
        }
      }
    },
    "backups.resetProjectHeadHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt zusätzlich die Git-Historie des Projekts zurück. Das ist nötig, wenn du ein Kern-Update rückgängig machst, sonst meldet die Updates-Seite weiterhin den neuen Stand. Wenn du diesen Commit schon gepusht hast, weicht dein lokaler Stand danach vom Remote ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also rewinds the project’s git history. That is needed when undoing a core update, or the Updates page will keep reporting the new state. If you have already pushed that commit, your local state will diverge from the remote afterwards."
          }
        }
      }
    },
