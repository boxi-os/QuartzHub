    "snippets.svgCleaned" : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "{{count}} Stelle aus dem SVG-Code entfernt, die eingebettet auf jeder Seite Skript ausführen, sie gestalten oder etwas von außen laden könnte (etwa <script>, onload, <style>)."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "{{count}} Stellen aus dem SVG-Code entfernt, die eingebettet auf jeder Seite Skript ausführen, sie gestalten oder etwas von außen laden könnten (etwa <script>, onload, <style>)."
                }
              }
            }
          }
