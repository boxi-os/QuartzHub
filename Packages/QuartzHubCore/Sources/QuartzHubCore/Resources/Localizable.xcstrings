    "themeEditor.delivery.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal ausliefern: QuartzControl holt die Schriftdateien einmal von Google und legt sie im Projekt ab. Die Website ruft nichts mehr bei Google auf (die DSGVO-freundliche Variante)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serving locally: QuartzControl fetches the font files from Google once and stores them in the project. The site then makes no request to Google at all (the GDPR-friendly option)."
          }
        }
      }
    },
