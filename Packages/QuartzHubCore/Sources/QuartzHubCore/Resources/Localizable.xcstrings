    "formsEditor.relay.configOpen" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch die config.php ist unter {{url}} für jeden lesbar, mit Secret und Empfängeradressen. Lösche sie vom Server und erzeuge unter „Selten gebraucht“ ein neues Secret."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.php can be read by anyone at {{url}} as well, secret and recipient addresses included. Delete it from the server and make a new secret under “Rarely needed”."
          }
        }
      }
    },
    "formsEditor.relay.configReadable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.php für den Webserver lesbar (0644)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "config.php readable by the web server (0644)"
          }
        }
      }
    },
    "formsEditor.relay.configReadableHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur nötig, wenn PHP beim Hoster als Webserver-Benutzer läuft; dann können auch andere Accounts auf dem Server Adressen und Secret lesen, und wo PHP nicht läuft, jeder im Web. QuartzControl setzt die Rechte des Relays bei jedem Hochladen neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only needed when the host runs PHP as the web server's user; other accounts on the server can then read the addresses and the secret too, and anyone on the web where PHP does not run. QuartzControl sets the relay's permissions again on every upload."
          }
        }
      }
    },
    "formsEditor.relay.conflict" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel „{{target}}“ überträgt per rsync und löscht, was der Build nicht hat, also auch „{{path}}“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The target “{{target}}” transfers with rsync and deletes what the build lacks, “{{path}}” included."
          }
        }
      }
    },
    "formsEditor.relay.counterDir" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner für Zähler"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder for counters"
          }
        }
      }
    },
    "formsEditor.relay.counterDirHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein absoluter Pfad auf dem Server, am besten außerhalb des Web-Verzeichnisses. Leer: „counters“ neben send.php."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An absolute path on the server, best outside the web root. Empty: “counters” next to send.php."
          }
        }
      }
    },
    "formsEditor.relay.countersNotWritable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHP kann nicht in den Ordner für Zähler schreiben, also schickt das Relay jede Nachricht durch: ohne Ratenlimit und ohne sich verbrauchte Proof-of-Work-Lösungen zu merken. Trage unter „Ordner für Zähler“ einen Ordner ein, in den PHP beim Hoster schreiben darf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHP cannot write to the folder for counters, so the relay lets every message through: with no rate limit and without remembering used proofs of work. Enter a folder PHP may write to at your host under “Folder for counters”."
          }
        }
      }
    },
    "formsEditor.relay.countersOpen" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „counters“ ist öffentlich lesbar, weil der Server keine .htaccess liest: Jeder kann sehen, wie viele Nachrichten ein Formular bekommt. Trage unter „Ordner für Zähler“ einen Pfad außerhalb des Web-Verzeichnisses ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The “counters” folder can be read by anyone, because the server reads no .htaccess: anyone can see how many messages a form gets. Enter a path outside the web root under “Folder for counters”."
          }
        }
      }
    },
