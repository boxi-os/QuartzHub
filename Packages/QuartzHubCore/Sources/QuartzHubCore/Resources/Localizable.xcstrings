      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür muss eine Basis-URL gesetzt sein (Konfiguration → Basis-URL). Die Schrift-URLs werden darauf umgeschrieben, sonst bricht der Build ab."
          }
        },
        "en" : {
          "stringUnit" : {
