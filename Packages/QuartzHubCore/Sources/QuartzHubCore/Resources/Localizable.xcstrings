            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "In der Datei steht noch der Ausschluss „{{names}}“ aus einer früheren Fassung. Er wirkt nicht und verschwindet, sobald du an diesem Seitentyp etwas umlegst und speicherst."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "In der Datei stehen noch {{count}} Ausschlüsse aus einer früheren Fassung ({{names}}). Sie wirken nicht und verschwinden, sobald du an diesem Seitentyp etwas umlegst und speicherst."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The file still holds the exclusion “{{names}}” from an earlier version. It has no effect and disappears once you change something about this page type and save."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The file still holds {{count}} exclusions from an earlier version ({{names}}). They have no effect and disappear once you change something about this page type and save."
