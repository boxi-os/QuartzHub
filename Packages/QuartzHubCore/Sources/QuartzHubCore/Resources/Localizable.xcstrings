    "formsEditor.intro" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz-forms hält alle Formulare der Website in einem Eintrag. Ein Formular steht auf einer Seite, wenn diese es über seine Kennung einbindet, oder als Layout-Formular auf jeder Seite. Jede Änderung wird sofort gespeichert."
          }
