    "main.zipUnsupportedMethod" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket verwendet ein nicht unterstütztes Kompressionsverfahren ({{method}})."
          }
