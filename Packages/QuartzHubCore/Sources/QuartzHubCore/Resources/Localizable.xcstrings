    "navigationsEditor.intro" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Navigation ist ein eigener Eintrag von quartz-navigations. Wähle eine aus, um ihre Variante und Optionen einzustellen; wo sie steht, legst du auf der Layout-Bühne fest. Jede Änderung wird sofort gespeichert, und die Vorschau lädt nach dem Neubau von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each navigation is an entry of its own of quartz-navigations. Pick one to set its variant and options; where it stands is set on the layout stage. Every change is saved at once, and the preview reloads by itself after the rebuild."
          }
        }
      }
    },
