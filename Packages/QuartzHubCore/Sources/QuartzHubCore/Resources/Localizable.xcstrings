        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "quartz-forms keeps all forms of the site in one entry. A form appears on a page that embeds it by its id, or on every page as the layout form. Every change is saved at once."
          }
        }
      }
    },
