    "multilanguageEditor.removeConfirm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache „{{name}}“ entfernen?\n\nSie verschwindet aus der Konfiguration, auch als Standardsprache und aus der Liste der veröffentlichten. Ihre Seiten bleiben liegen und gelten danach als Seiten der Standardsprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the language “{{name}}”?\n\nIt leaves the configuration, also as default language and from the published ones. Its pages stay and then count as pages of the default language."
          }
        }
      }
    },
    "multilanguageEditor.removeOnlyPublishedConfirm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache „{{name}}“ entfernen und {{others}} veröffentlichen?\n\n„{{name}}“ ist die einzige veröffentlichte Sprache. Ohne sie gilt die Liste als leer, und eine leere Liste veröffentlicht alle Sprachen. Der nächste Build und das nächste Veröffentlichen nehmen dann auch die mit, die du bisher zurückgehalten hast. Wer das nicht will, schaltet vorher eine andere Sprache auf „Veröffentlichen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the language “{{name}}” and publish {{others}}?\n\n“{{name}}” is the only published language. Without it the list counts as empty, and an empty list publishes every language. The next build and the next publish then include the ones you have held back so far. If that is not what you want, switch another language to “Publish” first."
          }
        }
      }
    },
