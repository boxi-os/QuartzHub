    "updates.core.openSnapshot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshot von vor dem Update öffnen →"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the snapshot from before the update →"
          }
        }
      }
    },
    "updates.core.pendingDetail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese eigenen Pakete fehlen in package.json oder stehen dort mit einer anderen Version: {{packages}}. „Update durchführen“ trägt sie wieder ein. Alternativ holst du unter Snapshots den Stand von vorher zurück, dort mit dem Schalter „Auch den Projekt-Commit zurücksetzen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These packages of yours are missing from package.json, or stand there at a different version: {{packages}}. “Run update” puts them back. Alternatively, take the project back to the state before it under Snapshots, there with the “Also reset the project commit” switch on."
          }
        }
      }
    },
    "updates.core.pendingHeading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein früheres Update ist nicht zu Ende gelaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An earlier update did not run to the end"
          }
        }
      }
    },
    "updates.core.pendingInstallDetail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kern ist zusammengeführt, aber „npm install“ ist dabei fehlgeschlagen: Die Abhängigkeiten in node_modules passen nicht zu package.json. „Update durchführen“ holt das nach. Alternativ holst du unter Snapshots den Stand von vorher zurück, dort mit dem Schalter „Auch den Projekt-Commit zurücksetzen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The core has been merged, but “npm install” failed while doing it: the dependencies in node_modules do not match package.json. “Run update” catches up. Alternatively, take the project back to the state before it under Snapshots, there with the “Also reset the project commit” switch on."
          }
        }
      }
    },
    "updates.core.runUpdate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
