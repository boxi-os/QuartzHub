    "layoutEditor.overview.intro" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komponenten werden einmal für alle Seiten platziert. Jeder Seitentyp wird in seinem zugeordneten Frame gebaut und kann einzelne Komponenten oder ganze Bereiche ausblenden. Der Frame entscheidet, für welche Bereiche er überhaupt Platz hat. Die Tabelle zeigt, was davon auf jedem Seitentyp ankommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Components are placed once for all pages. Each page type is built in its assigned frame and can hide single components or whole areas. The frame decides which areas it has room for at all. The table shows what reaches each page type."
          }
        }
      }
    },
