    "publish.uploadEverythingHint" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwirft, was QuartzControl zuletzt an dieses Ziel geschickt hat. Danach bietet die Vorschau wieder den ganzen Build an. Für alles, was QuartzControl nicht sehen kann: eine von Hand gelöschte Datei auf dem Server, eine abgebrochene Übertragung, eine Wiederherstellung durch den Anbieter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discards what QuartzControl last sent to this target. The preview then offers the whole build again. For everything QuartzControl cannot see: a file deleted on the server by hand, an interrupted transfer, a restore by the provider."
          }
        }
      }
    },
    "publish.webhookExplainer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Webhook lädt keine Dateien hoch, sondern stößt einen Build beim Anbieter an (Netlify, Cloudflare Pages, Vercel, CI). Deshalb gibt es hier keine Dateiliste: Der Build läuft dort, nicht hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A webhook uploads nothing; it asks a provider (Netlify, Cloudflare Pages, Vercel, CI) to build. That is why there is no file list here: the build runs there, not on this machine."
          }
        }
      }
    },
