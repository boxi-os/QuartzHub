    "formsEditor.relay.checkHttp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} antwortet kein Relay (HTTP {{status}}). Stimmen Ziel, Unterordner und Adresse von send.php?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No relay answers at {{url}} (HTTP {{status}}). Are the target, the folder and the send.php address right?"
          }
        }
      }
    },
    "formsEditor.relay.checkHttpAuth" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} verlangt der Server eine Anmeldung (HTTP 401), deshalb konnte das Relay nicht geprüft werden. Besucher ohne diese Anmeldung können die Formulare nicht absenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server asks for a login at {{url}} (HTTP 401), so the relay could not be checked. Visitors without that login cannot send the forms."
          }
        }
      }
    },
    "formsEditor.relay.checkHttpCdn" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} antwortet das CDN vor dem Server mit HTTP {{status}}: Es bekommt vom Server dahinter keine gültige Antwort. Versuche es später noch einmal; bleibt es so, frag den Hoster oder den Anbieter des CDN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The CDN in front of the server answers at {{url}} with HTTP {{status}}: it gets no valid answer from the server behind it. Try again later; if it stays so, ask the host or the CDN provider."
          }
        }
      }
    },
    "formsEditor.relay.checkHttpDenied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server verweigert den Zugriff auf {{url}} (HTTP 403). Meist liegt das an den Rechten des Ordners oder an einer Firewall des Hosters."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refuses access to {{url}} (HTTP 403). Usually the folder's permissions or a firewall of the host are the reason."
          }
        }
      }
    },
    "formsEditor.relay.checkHttpNoPhp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} erreicht der Webserver PHP nicht (HTTP {{status}}). Versuche es später noch einmal; bleibt es so, frag den Hoster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The web server does not reach PHP at {{url}} (HTTP {{status}}). Try again later; if it stays so, ask the host."
          }
        }
      }
    },
    "formsEditor.relay.checkHttpRate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Abfrage unter {{url}} wegen zu vieler Anfragen abgewiesen (HTTP 429), deshalb konnte das Relay nicht geprüft werden. Lade es später noch einmal hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server turned the check at {{url}} away for too many requests (HTTP 429), so the relay could not be checked. Upload it again later."
          }
        }
      }
    },
    "formsEditor.relay.checkHttpServerError" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server antwortet unter {{url}} mit Fehler 500 und einer eigenen Fehlerseite. Den Grund nennt das Fehlerprotokoll des Webservers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server answers at {{url}} with error 500 and an error page of its own. The web server's error log names the reason."
          }
        }
      }
    },
    "formsEditor.relay.checkNoPhp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} läuft kein PHP: Der Server liefert send.php als Text aus. Lade das Relay in einen Ordner, in dem PHP läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHP does not run at {{url}}: the server hands out send.php as text. Upload the relay to a folder where PHP runs."
          }
        }
      }
    },
    "formsEditor.relay.checkNoUrl" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay konnte nicht geprüft werden, weil die Adresse von send.php fehlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay could not be checked because the send.php address is missing."
          }
        }
      }
    },
    "formsEditor.relay.checkOk" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay antwortet unter {{url}}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay answers at {{url}}."
          }
        }
      }
    },
    "formsEditor.relay.checkOtherRelay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} antwortet ein anderes Relay als das eben hochgeladene. Stimmen Ziel und Unterordner zur Adresse von send.php?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relay answers at {{url}}, but not the one just uploaded. Do the target and the folder match the send.php address?"
          }
        }
      }
    },
    "formsEditor.relay.checkPhpCannotRead" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} antwortet PHP selbst „File not found.“: Es darf send.php nicht lesen, meist weil es beim Hoster als ein anderer Benutzer läuft als der Upload-Zugang, oder die Datei liegt nicht dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHP itself answers “File not found.” at {{url}}: it may not read send.php, mostly because it runs as another user at the host than the upload account, or the file is not there."
          }
        }
      }
    },
    "formsEditor.relay.checkPhpError" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay antwortet mit Fehler 500 ohne eigene Meldung. Meist kann PHP die config.php nicht lesen, weil es beim Hoster als Webserver-Benutzer läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay answers with error 500 and no message of its own. Usually PHP cannot read config.php because the host runs it as the web server's user."
          }
        }
      }
    },
    "formsEditor.relay.checkPhpErrorReadable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay antwortet mit Fehler 500 ohne eigene Meldung. Den Grund nennt das Fehlerprotokoll des Webservers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay answers with error 500 and no message of its own. The web server's error log names the reason."
          }
        }
      }
    },
    "formsEditor.relay.checkPhpMessage" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHP gibt unter {{url}} eine Fehlermeldung aus statt der Antwort des Relays: „{{message}}“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PHP prints an error at {{url}} instead of the relay’s answer: “{{message}}”"
          }
        }
      }
    },
    "formsEditor.relay.checkPostRedirect" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} leitet der Server mit {{status}} auf {{to}} weiter, und dabei schickt der Browser ein Formular ohne Inhalt. Trage {{to}} als Adresse von send.php ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At {{url}} the server redirects with {{status}} to {{to}}, and the browser sends a form there without its content. Enter {{to}} as the send.php address."
          }
        }
      }
    },
    "formsEditor.relay.checkRedirect" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} leitet der Server auf {{to}} weiter, und dort kommen die Anfragen der Formulare ohne die Origin der Website an. Trage die Adresse nach der Weiterleitung als Adresse von send.php ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At {{url}} the server redirects to {{to}}, where the forms' requests arrive without the site's origin. Enter the address after the redirect as the send.php address."
          }
        }
      }
    },
    "formsEditor.relay.checkRedirectLocal" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} leitet der Server auf {{to}} weiter, eine Adresse auf diesem Rechner oder im lokalen Netz, wo die Formulare der Besucher nicht ankommen. Stimmen Ziel, Unterordner und Adresse von send.php?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At {{url}} the server redirects to {{to}}, an address on this computer or in the local network, where visitors' forms do not arrive. Are the target, the folder and the send.php address right?"
          }
        }
      }
    },
    "formsEditor.relay.checkRedirectNoRelay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter {{url}} leitet der Server auf {{to}} weiter, und dort antwortet kein Relay. Stimmen Ziel, Unterordner und Adresse von send.php?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At {{url}} the server redirects to {{to}}, where no relay answers. Are the target, the folder and the send.php address right?"
          }
        }
      }
    },
    "formsEditor.relay.checkRelayError" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Relay lehnt die Probe ab (HTTP {{status}}, „{{error}}“): {{message}}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relay refuses the probe (HTTP {{status}}, “{{error}}”): {{message}}"
          }
        }
      }
