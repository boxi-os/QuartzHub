    "extraContent.files.renameReverted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{to}}“ heißt wieder „{{from}}“: Die Boxen, die die Datei nennen, konnten nicht nachgezogen werden, weil die Konfiguration nicht geschrieben werden konnte (Meldung oben)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{{to}}” is called “{{from}}” again: the boxes that name the file could not be updated, because the configuration could not be written (message above)."
          }
        }
      }
    },
    "extraContent.files.renameStuck" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„{{from}}“ heißt jetzt „{{to}}“, aber die Boxen, die die Datei nennen, nennen weiter „{{from}}“. Die Konfiguration konnte nicht geschrieben werden, und das Zurückbenennen ist auch gescheitert. Benenne die Datei zurück oder trage den neuen Namen in den Boxen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“{{from}}” is now called “{{to}}”, but the boxes that name the file still name “{{from}}”. The configuration could not be written, and renaming the file back failed too. Rename the file back or enter the new name in the boxes."
          }
        }
      }
    },
